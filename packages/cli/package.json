{
  "name": "@badui/cli",
  "version": "0.1.0",
  "description": "badui CLI — run a .ts file or page directory with bundled React client assets",
  "license": "MIT",
  "type": "module",
  "bin": {
    "badui": "./bin/badui"
  },
  "exports": {
    ".": "./src/main.ts"
  },
  "files": [
    "bin",
    "src",
    "client-dist",
    "README.md",
    "LICENSE",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "copy-client": "bun scripts/copy-client.ts",
    "prepack": "bun run copy-client"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tfsoares/bad-ui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/tfsoares/bad-ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@badui/compiler": "workspace:*",
    "@badui/core": "workspace:*",
    "@badui/ui": "workspace:*"
  }
}
