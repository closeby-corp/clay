{
  "name": "@close-by/clay-cli",
  "version": "0.1.0",
  "description": "clay CLI — run a .ts file or page directory with bundled React client assets",
  "license": "MIT",
  "type": "module",
  "bin": {
    "clay": "./bin/clay"
  },
  "exports": {
    ".": "./src/main.ts"
  },
  "files": [
    "bin",
    "src",
    "client-dist",
    "README.md",
    "LICENSE",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "copy-client": "bun scripts/copy-client.ts",
    "prepack": "bun run copy-client"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/closeby-corp/clay.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/closeby-corp/clay#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@close-by/clay-compiler": "workspace:*",
    "@close-by/clay-core": "workspace:*",
    "@close-by/clay": "workspace:*"
  }
}
