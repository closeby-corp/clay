{
  "name": "@close-by/clay",
  "version": "0.2.10",
  "description": "NiceGUI-like ui.* facade for Clay apps",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./page-tsconfig": "./page-tsconfig.json",
    "./docs-dir": "./src/docs-dir.ts",
    "./docs/*": "./docs/*",
    "./skill": "./SKILL.md",
    "./SKILL.md": "./SKILL.md"
  },
  "files": [
    "src",
    "docs",
    "SKILL.md",
    "page-tsconfig.json",
    "README.md",
    "LICENSE",
    "!src/**/*.test.ts",
    "!src/**/__fixtures__"
  ],
  "scripts": {
    "sync-docs": "bun ../../scripts/sync-docs.ts",
    "prepack": "bun run sync-docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/closeby-corp/clay.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/closeby-corp/clay#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@close-by/clay-compiler": "workspace:*",
    "@close-by/clay-core": "workspace:*",
    "@close-by/clay-components": "workspace:*",
    "@close-by/clay-server": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
